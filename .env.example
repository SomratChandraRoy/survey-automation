# Opinion Edge Credentials
OPINION_EDGE_EMAIL=your_email@example.com
OPINION_EDGE_PASSWORD=your_password

# Opinion Edge Base URL (panel subdomain)
OPINION_EDGE_BASE_URL=https://panel.opinion-edge.com

# Proxy Configuration (optional - leave blank to run without proxy)
# Get from your proxy provider, e.g. Brightdata, Oxylabs, Smartproxy
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision:latest

# CAPTCHA Solving Configuration
# =============================
# Choose your method:

# METHOD 1: FREE Audio Solver (RECOMMENDED for $0 budget)
# Uses Google Speech Recognition API (completely FREE!)
# No API key needed!
CAPTCHA_METHOD=audio_free
# Success rate: 70-80%
# Cost: $0

# METHOD 2: FREE Trial Services (Good for getting started)
# Get free credits from these services:
# - Anti-Captcha: https://anti-captcha.com ($1-2 free)
# - CapSolver: https://capsolver.com ($0.50-1 free)
# ANTICAPTCHA_FREE_KEY=your_free_trial_key_here
# CAPSOLVER_FREE_KEY=your_free_trial_key_here
# CAPTCHA_METHOD=free_trial

# METHOD 3: Paid Service (Best success rate, but costs money)
# 2Captcha: https://2captcha.com ($3 minimum)
# CAPTCHA_API_KEY=your_2captcha_api_key_here
# CAPTCHA_METHOD=2captcha

# METHOD 4: Avoidance Only (Best if you have good stealth)
# Try to avoid CAPTCHAs entirely with perfect human behavior
# CAPTCHA_METHOD=avoid_only

# Persona Profile
PERSONA_NAME=Dirk Baer
PERSONA_ADDRESS=Gruenauer Strasse 48, 21635 Jork
PERSONA_MOTHER_MAIDEN=Beyer
PERSONA_PHONE=04162 70 35 67
PERSONA_COUNTRY_CODE=49
PERSONA_BIRTHDAY=10.09.1963
PERSONA_AGE=78
PERSONA_ZODIAC=Virgo
PERSONA_GEO_LAT=53.578107
PERSONA_GEO_LON=9.698209

# Automation Settings
MAX_RETRIES=3
ACTION_DELAY_MIN=3
ACTION_DELAY_MAX=8
SCREENSHOT_CLEANUP_INTERVAL=1200
LOG_ROTATION_SIZE_MB=10
LOG_RETENTION_COUNT=5

# Backup Settings
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=1
BACKUP_RETENTION_DAYS=30
BACKUP_TYPE=local
# For cloud backup, set BACKUP_TYPE=s3 or gdrive and configure below
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_BUCKET_NAME=your_bucket

# Monitoring
FLASK_PORT=5000
FLASK_DEBUG=false
# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Dashboard Authentication (optional but recommended for production)
# Leave blank to disable authentication
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
